{
  "name": "agentpm-monorepo",
  "version": "1.3.0",
  "private": true,
  "description": "AgentPM Monorepo — The Package Manager & Security Ecosystem for AI Agents",
  "workspaces": [
    "packages/*",
    "web",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=@amajumdar2249/agentpm",
    "test": "npm run test --workspace=@amajumdar2249/agentpm",
    "start": "node packages/cli/dist/index.js",
    "audit": "node packages/cli/dist/index.js audit",
    "publish:cli": "npm publish --workspace=@amajumdar2249/agentpm --access public"
  },
  "keywords": [
    "ai",
    "agentpm",
    "monorepo",
    "package-manager",
    "security"
  ],
  "author": "Aurgho Majumdar",
  "license": "MIT"
}
